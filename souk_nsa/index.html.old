<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="souk nsa">
<title>souk nsa</title>
<link rel="icon" href="assets/images/favicon.png">
<link rel="stylesheet" href="css/themes.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/rtl.css">
<link rel="stylesheet" href="css/components.css">
<link rel="stylesheet" href="css/pages.css">
</head>
<body data-page="home">
<header id="app-header" class="top-bar">
  <div id="banner-slot" class="banner-slot" hidden></div>
  <div class="search-row">
    <button id="btn-filters" class="filter-btn" type="button" data-i18n-aria="filters.title">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="9" cy="6" r="1.6" fill="#fff" stroke="none"/><circle cx="15" cy="12" r="1.6" fill="#fff" stroke="none"/><circle cx="9" cy="18" r="1.6" fill="#fff" stroke="none"/></svg>
    </button>
    <div class="search-box">
      <button id="btn-search" class="search-ico" type="button" data-i18n-aria="search.button"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
      <input id="q" type="search" dir="rtl" autocomplete="off" maxlength="100" data-i18n-aria="search.button">
      <div id="suggest" class="suggest" hidden></div>
    </div>
    <a id="btn-settings" class="settings-btn" href="settings.html" data-i18n-aria="nav.settings">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 1v3m0 16v3M4.22 4.22l2.12 2.12m11.32 11.32l2.12 2.12M1 12h3m16 0h3M4.22 19.78l2.12-2.12m11.32-11.32l2.12-2.12"/></svg>
    </a>
  </div>
  <div id="chips-wrap" class="chips-wrap"><div id="chips" class="chips"></div></div>
  <div id="sub-wrap" class="chips-wrap" hidden><div id="sub-chips" class="chips chips--sub"></div></div>
</header>
<main class="container">
  <div id="dym" class="did-you-mean"></div>
  <div id="active-tags" class="active-filters"></div>
  <section id="grid" class="grid" aria-live="polite"></section>
  <div id="sentinel" class="load-more"></div>
</main>
<script src="js/env.js"></script>
<script src="js/config.js"></script>
<script src="js/console-logger.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.js"></script>
<script src="js/supabase.js"></script>
<script src="js/sanitize.js"></script>
<script src="js/utils.js"></script>
<script src="js/ui.js"></script>
<script src="js/i18n.js"></script>
<script src="js/theme.js"></script>
<script src="js/router.js"></script>
<script src="js/auth.js"></script>
<script src="js/geo.js"></script>
<script src="js/categories.js"></script>
<script src="js/price.js"></script>
<script src="js/ads.js"></script>
<script src="js/cards.js"></script>
<script src="js/filters.js"></script>
<script src="js/search.js"></script>
<script src="js/offline-cache.js"></script>
<script src="js/fingerprint.js"></script>
<script src="js/interests.js"></script>
<script src="js/likes.js"></script>
<script src="js/notifications.js"></script>
<script src="js/alerts.js"></script>
<script src="js/tracking.js"></script>
<script src="js/banners.js"></script>
<script src="js/chat.js"></script>
<script src="js/settings.js"></script>
<script src="js/app.js"></script>
<script src="js/logger.js"></script>
</body>
</html>
