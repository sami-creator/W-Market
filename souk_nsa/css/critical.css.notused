/* critical.css — CSS الحيوي للشاشة الأولى فقط (above-the-fold) */

/* ══ المتغيرات والثيم ══ */
:root{--c-on:#fff;--c-primary:#F472B6;--c-primary-2:#EC4899;--c-soft:color-mix(in srgb,var(--c-primary) 16%,var(--surface));--c-accent:#10B981;--nav-h:38px}
:root[data-color="rose"]{--c-primary:#F472B6;--c-primary-2:#EC4899}
:root[data-color="fuchsia"]{--c-primary:#D946EF;--c-primary-2:#C026D3}
:root[data-color="red"]{--c-primary:#EF4444;--c-primary-2:#DC2626}
:root[data-color="orange"]{--c-primary:#F97316;--c-primary-2:#EA580C}
:root[data-color="gold"]{--c-primary:#D4A017;--c-primary-2:#B8860B}
:root[data-color="green"]{--c-primary:#16A34A;--c-primary-2:#15803D}
:root[data-color="teal"]{--c-primary:#0D9488;--c-primary-2:#0F766E}
:root[data-color="sky"]{--c-primary:#0EA5E9;--c-primary-2:#0284C7}
:root[data-color="blue"]{--c-primary:#2563EB;--c-primary-2:#1D4ED8}
:root[data-color="indigo"]{--c-primary:#4F46E5;--c-primary-2:#4338CA}
:root[data-color="violet"]{--c-primary:#8B5CF6;--c-primary-2:#7C3AED}
:root[data-color="brown"]{--c-primary:#92613A;--c-primary-2:#7A4F2D}
:root[data-color="beige"]{--c-primary:#B89B72;--c-primary-2:#9C8059}
:root[data-color="slate"]{--c-primary:#475569;--c-primary-2:#334155}

:root[data-theme="light"]{--bg:#FFFFFF;--surface:#FFFFFF;--surface-2:#F3F1F5;--text:#1F1B24;--muted:#8A8590;--border:#F1EFF3;--danger:#EF4444;--ok:#10B981;--star:#F5A623;--shadow:0 10px 25px rgba(31,27,36,.08);--page-bg:#EDEBEF}
:root,:root[data-theme="dark"]{--bg:#16131A;--surface:#201C27;--surface-2:#2B2632;--text:#F4F0F7;--muted:#A29BAB;--border:#332D3B;--danger:#F87171;--ok:#34D399;--star:#F5A623;--shadow:0 10px 25px rgba(0,0,0,.35);--page-bg:#0F0D12}

/* ══ Reset أساسي ══ */
*,*::before,*::after{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{overflow-x:hidden;-webkit-text-size-adjust:100%;background:var(--page-bg)}
body{overflow-x:hidden;width:100%;margin:0;background:var(--bg);color:var(--text);font-family:var(--font,'Poppins','Segoe UI',system-ui,-apple-system,sans-serif);font-size:15px;line-height:1.55;min-height:100vh;max-width:600px;margin-inline:auto;padding-bottom:calc(var(--nav-h) + 76px + env(safe-area-inset-bottom,0px));position:relative}
body.is-gated main{visibility:hidden}
img,svg,video{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{cursor:pointer}
[hidden]{display:none!important}
.container{min-width:0;width:100%;margin-inline:auto;padding-inline:16px}

/* ══ الشريط العلوي ══ */
:root{--edge:calc((100% - min(100%,600px))/2)}
.top-bar{position:sticky;top:0;z-index:20;background:var(--bg);padding:calc(10px + env(safe-area-inset-top,0px)) 16px 10px;box-shadow:0 6px 16px rgba(31,27,36,.05)}
.banner-slot{height:44px;border-radius:14px;overflow:hidden;background:var(--c-soft);display:flex;align-items:center;justify-content:center;font-weight:700;color:var(--c-primary);margin-bottom:10px}
.search-row{min-width:0;display:flex;align-items:center;gap:10px;position:relative}
.filter-btn{order:0;flex:none;width:46px;height:46px;border-radius:14px;background:var(--c-primary);display:flex;align-items:center;justify-content:center;box-shadow:0 8px 16px color-mix(in srgb,var(--c-primary) 35%,transparent);cursor:pointer;border:none}
.search-box{order:1;flex:1;min-width:0;display:flex;align-items:center;gap:10px;background:var(--surface-2);border-radius:16px;padding:0 16px}
.search-box input{border:none;outline:none;background:transparent;font-size:14px;color:var(--text);width:auto;font-family:inherit;padding:12px 0;min-width:0;flex:1}
.settings-btn{order:2;flex:none;width:46px;height:46px;border-radius:14px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;border:none}

/* ══ الأصناف (chips) ══ */
.chips-wrap{position:relative;margin-top:10px;overflow:hidden}
.chips{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding-bottom:2px}
.chips::-webkit-scrollbar{display:none}
.chip{flex:none;padding:8px 18px;border-radius:14px;font-size:13px;font-weight:600;color:var(--muted);background:var(--surface-2);border:0;white-space:nowrap;cursor:pointer}
.chip.active{background:var(--c-primary);color:var(--c-on);box-shadow:0 8px 16px color-mix(in srgb,var(--c-primary) 30%,transparent)}

/* ══ شبكة البطاقات ══ */
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:12px;width:100%;min-height:100vh;align-content:start}
.grid>*{min-width:0}
.card{min-width:0;max-width:100%;background:var(--surface);border-radius:20px;padding:12px 12px 14px;box-shadow:var(--shadow);border:1px solid var(--border);position:relative;cursor:pointer;display:block;overflow:visible}
.card .img-wrap{width:100%;aspect-ratio:4/5;border-radius:14px;overflow:hidden;background:var(--surface-2);margin-bottom:10px;position:relative}
.card .img-wrap img{width:100%;height:100%;object-fit:cover;display:block}
.seller-avatar img{width:46px;height:46px;border-radius:50%;flex-shrink:0}
.card h3{margin:0 0 2px;font-size:14px;font-weight:700;color:var(--text);text-align:right;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.seller-row{display:flex;align-items:center;gap:6px;margin:0 0 2px}
.seller-avatar{width:30px;height:30px;border-radius:50%;flex:none;position:relative}
.card .price{display:flex;align-items:baseline;gap:6px;font-size:14px;font-weight:700;color:var(--c-success,#16a34a);margin:2px 0 8px;direction:ltr}

/* ══ Skeleton ══ */
.card--skeleton{padding:12px}
@keyframes sh{to{background-position:-200% 0}}
.sk{background:linear-gradient(90deg,var(--surface-2),var(--border),var(--surface-2));background-size:200% 100%;animation:sh 1.2s infinite;border-radius:8px}
.sk-img{aspect-ratio:4/5;border-radius:14px}
.sk-line{height:12px;margin:10px 0 0}
.sk-short{width:50%}

/* ══ الشريط السفلي ══ */
.bottom-bar{position:fixed;left:var(--edge);right:var(--edge);bottom:0;z-index:20;height:calc(var(--nav-h) + env(safe-area-inset-bottom,0px));padding-bottom:env(safe-area-inset-bottom,0px);background:var(--c-primary);display:flex;align-items:center;justify-content:space-around;direction:rtl;transition:transform .15s cubic-bezier(.4,0,.2,1),background .2s;will-change:transform;transform:translateY(0)}
.bottom-bar.hidden{transform:translateY(100%)}
.nav-item{flex:1;display:flex;align-items:center;justify-content:center;height:100%;color:rgba(255,255,255,.65);cursor:pointer;border:none;background:transparent;padding:0}
.nav-item.active{color:#fff}
.nav-item svg{width:18px;height:18px}
.fab{position:fixed;left:50%;bottom:calc(var(--nav-h) + env(safe-area-inset-bottom,0px) + 3px);transform:translateX(-50%);width:52px;height:52px;border-radius:50%;background:var(--c-primary);border:4px solid var(--bg);display:flex;align-items:center;justify-content:center;box-shadow:0 10px 20px color-mix(in srgb,var(--c-primary) 45%,transparent);z-index:25;cursor:pointer}
.fab.hidden{transform:translateX(-50%) translateY(80px);opacity:0;pointer-events:none}
